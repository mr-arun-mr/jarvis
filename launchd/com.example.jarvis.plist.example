<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.jarvis</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/jarvis/.venv/bin/python</string>
    <string>__HOME__/jarvis/server.py</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/jarvis</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/jarvis/server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/jarvis/server.log</string>
</dict>
</plist>
